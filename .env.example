# اختياري: الدفع الأساسي في المتجر تحويل بنكي (آيبان) ويُضبط في lib/config.ts.
# مفاتيح ميسر (Moyasar) — من لوحة التحكم: https://dashboard.moyasar.com → Settings → API Keys
# استخدم مفاتيح الاختبار (pk_test_ / sk_test_) أولاً، ثم مفاتيح الإنتاج (pk_live_ / sk_live_)
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=

# وسائل الدفع المفعّلة في حساب ميسر، مفصولة بفاصلة: creditcard,applepay,stcpay
# creditcard تشمل مدى وفيزا وماستركارد.
# لا تضف applepay قبل توثيق النطاق في ميسر، ولا stcpay قبل تفعيلها في حسابك.
NEXT_PUBLIC_MOYASAR_METHODS=creditcard

# رابط الموقع النهائي (يستخدم لرابط العودة بعد الدفع). اتركه فارغاً ليُستنتج تلقائياً.
NEXT_PUBLIC_SITE_URL=

# ---------- لوحة التحكم /manager ----------
# بيانات دخول المدير (لا تضعها في الكود)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# اختياري: سر توقيع جلسات الدخول (نص عشوائي طويل)
SESSION_SECRET=

# قاعدة البيانات: تُضاف تلقائياً عند ربط Upstash Redis من Vercel → Storage
# (يقبل الاسمين: UPSTASH_REDIS_REST_URL/TOKEN أو KV_REST_API_URL/TOKEN)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# رفع صور المنتجات: يُضاف تلقائياً عند ربط Vercel Blob (متجر عام Public)
BLOB_READ_WRITE_TOKEN=
